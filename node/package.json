    "ubel-npm": "bin/npm.js",
    "ubel-pnpm": "bin/pnpm.js",
    "ubel-bun": "bin/bun.js",
    "ubel-yarn": "bin/yarn.js",
    "ubel-agent": "bin/agent.js",
    "ubel-platform": "bin/platform.js",
    "ubel-sast": "bin/sast.js",
    "ubel-mal": "bin/mal.js",
    "ubel-chunk": "bin/chunk.js",
    "ubel-cicd": "bin/cicd.js",
    "ubel-docker":"bin/docker.js",
    "ubel-secrets":"bin/secrets.js",
    "ubel-license":"bin/license.js"
  },
  "scripts": {},
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "sca/main.js",
  "exports": {
