{
  "name": "ubel-vscode",
  "displayName": "UBEL — Supply-Chain security scanner and firewall",
  "description": "Multi-ecosystem dependency security scanner, secrets detector, and supply-chain firewall. Scans Node.js, Python, PHP, Rust, Go, C#/.NET, Java/Kotlin, and Ruby projects — plus your VS Code extensions, exposed secrets, and the development environment — for vulnerabilities, hardcoded credentials, and malicious packages. Runs entirely locally, no cloud calls except for osv.dev and NVD API (both mirror-configurable).",
  "version": "0.12.1",
  "publisher": "Arcane-Spark",
  "author": {
    "name": "Ala Bouali",
    "email": "ala.bouali.1997@gmail.com",
    "url": "https://github.com/AlaBouali"
  },
  "icon": "ubel_logo.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AlaBouali/ubel"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "homepage": "https://github.com/AlaBouali/ubel",
  "bugs": {
    "url": "https://github.com/AlaBouali/ubel/issues"
  },
  "galleryBanner": {
    "color": "#0d1117",
    "theme": "dark"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "security",
    "supply chain",
    "vulnerability",
    "malicious packages",
    "python",
    "node.js",
    "php",
    "rust",
    "go",
    "c#",
    "java",
    "ruby",
    ".NET",
    "scan",
    "vulnerability assessment",
    "dependencies",
    "audit",
    "malware",
    "firewall",
    "secrets",
    "secret scanning",
    "credential detection",
    "trivy",
    "sbom",
    "cve",
    "cvss",
    "osv",
    "sca",
    "software composition analysis",
    "devops",
    "devsecops",
    "npm",
    "pnpm",
    "yarn",
    "bun",
    "pip",
    "composer",
    "cargo",
    "go modules",
    "nuget",
    "maven",
    "bundler"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ubel.scan",
        "title": "UBEL: Scan Project",
        "category": "UBEL"
      },
      {
        "command": "ubel.scanExtensions",
        "title": "UBEL: Scan Code Editor's Extensions",
        "category": "UBEL"
      },
      {
        "command": "ubel.scanPlatform",
        "title": "UBEL: Scan Host Platform",
        "category": "UBEL"
      },
      {
        "command": "ubel.scanSecrets",
        "title": "UBEL: Scan project for Exposed Secrets",
        "category": "UBEL"
      }
    ],
    "keybindings": [
      {
        "command": "ubel.scan",
        "key": "ctrl+alt+u",
        "mac": "cmd+alt+u"
      },
      {
        "command": "ubel.scanExtensions",
        "key": "ctrl+alt+x",
        "mac": "cmd+alt+x"
      },
      {
        "command": "ubel.scanPlatform",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p"
      },
      {
        "command": "ubel.scanSecrets",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s"
      }
    ]
  },
  "scripts": {
    "prepackage": "xcopy /E /I /Y ..\\node\\sca node\\src",
    "package": "vsce package --no-dependencies --out ubel-vscode-extension.vsix --allow-missing-repository",
    "vs_install": "code --install-extension ubel-vscode-extension.vsix",
    "clean": "rmdir /S /Q node || rm -rf node"
  }
}